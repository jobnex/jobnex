# OpenRouter routes the configured Gemini and GPT models through one OpenAI-compatible endpoint.
OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Required for the shared 30-day JD analysis cache. Both must connect as the
# scoped `resume_agent_cache` role (USAGE+CREATE on schema `resume_cache`
# ONLY — see backend/migrations/20260907000000_create_resume_cache_schema.sql;
# that role is provisioned out of band, never in a migration file).
#
# DATABASE_URL is read directly by `python -m low_risk_agent.cli` (the manual/
# offline tool) — set it in your shell or here for local runs.
#
# The production path (portal.py, spawned by the Rust backend for every
# generation) intentionally does NOT read DATABASE_URL — the backend process
# strips its own DATABASE_URL/WORKER_DATABASE_URL before spawning it, so the
# subprocess never inherits the main app's full-access role. It reads this
# distinctly-named var instead, forwarded from THIS file by tailor.rs's
# existing agent-.env allow-list:
DATABASE_URL=postgresql://resume_agent_cache:replace-me@localhost:5432/neondb?sslmode=require
RESUME_AGENT_CACHE_DATABASE_URL=postgresql://resume_agent_cache:replace-me@localhost:5432/neondb?sslmode=require
# Same secret either way — cache keys must be reproducible across every
# subprocess invocation, or every request is a guaranteed cache miss.
JD_CACHE_HMAC_SECRET=replace-with-at-least-32-random-characters

# LangSmith Tracing
RESUME_ENABLE_LANGSMITH=0
RESUME_LANGSMITH_ALLOW_CONTENT=1
# LANGSMITH_API_KEY=lsv2...
# LANGSMITH_PROJECT=low-risk-resume-production

# Optional final-result storage in trail_dev; set this in the launching process.
# Kept separate from the shared JD cache connection.
RESUME_RESULTS_DATABASE_URL=
