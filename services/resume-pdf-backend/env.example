# Supply secrets through GCP Secret Manager. Do not commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/neondb?sslmode=require
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=PRIVATE_BUCKET
R2_ACCESS_KEY_ID=SECRET_REFERENCE
R2_SECRET_ACCESS_KEY=SECRET_REFERENCE
BACKEND_SERVICE_TOKEN=GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ROOT=.
HOST=0.0.0.0
PORT=8080
MAX_COMPILATIONS=2
COMPILE_TIMEOUT_SECONDS=45
# Linux container sets TYPST_BIN=/usr/local/bin/typst
# Windows local development may set TYPST_BIN to the existing typst.exe path.
