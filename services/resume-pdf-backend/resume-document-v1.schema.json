{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobnex.co/contracts/resume-document-v1.schema.json",
  "title": "ResumeDocumentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "source",
    "personalInfo",
    "summary",
    "skills",
    "experience",
    "projects",
    "education",
    "additionalSections",
    "sectionOrder",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ResumeDocumentV1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileSha256",
        "textSha256",
        "revision",
        "validatorVersion"
      ],
      "properties": {
        "fileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "textSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "validatorVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "personalInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "title",
        "email",
        "phone",
        "linkedin",
        "github",
        "location",
        "extraContacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "extraContacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "company",
          "location",
          "duration",
          "bullets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "technologies",
          "duration",
          "bullets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "institution",
          "location",
          "degree",
          "duration",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "institution": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "additionalSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "sectionOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fieldId",
          "sourceSpan",
          "spanStart",
          "spanEnd",
          "page",
          "box",
          "roleId",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fieldId": {
            "type": "string",
            "minLength": 1
          },
          "sourceSpan": {
            "type": "string"
          },
          "spanStart": {
            "type": "integer",
            "minimum": 0
          },
          "spanEnd": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "box": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              }
            ]
          },
          "roleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "enum": [
              "pdf",
              "user"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
