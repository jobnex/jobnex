@@ -0,0 +1,135 @@
+"use client";
+
+import { useState, useEffect } from "react";
+import { usePathname } from "next/navigation";
+import { useJobStore } from "@/store/useJobStore";
+import { useHeaderMorph } from "@/lib/hooks/useHeaderMorph";
+import { HeaderNav } from "./header/HeaderNav";
+import { HeaderSearchbar } from "./header/HeaderSearchbar";
+import { HeaderShortcuts } from "./header/HeaderShortcuts";
+import { MobileSearchButton } from "./header/MobileSearchButton";
+
+export function Header() {
+  const pathname = usePathname();
+  const isJobBoard = pathname === "/";
+
+  // Mathematical continuous snap engine
+  const {
+    scrollProgress,
+    isTransitioning,
+    isFocusedOverride,
+    setFocusedOverride,
+    headerRef,
+    shortcutsContainerRef,
+    shortcutsTrackRef,
+  } = useHeaderMorph({ enabled: isJobBoard });
+
+  const [isDrawerExpanded, setIsDrawerExpanded] = useState(false);
+  const [drawerHeight, setDrawerHeight] = useState(44);
+
+  const setIsHeaderScrolled = useJobStore((s) => s.setIsHeaderScrolled);
+  const isJdOpen = useJobStore((s) => s.isJdOpen);
+
+  // Sync scroll status to global store on settled state
+  useEffect(() => {
+    setIsHeaderScrolled(scrollProgress > 0.5);
+  }, [scrollProgress, setIsHeaderScrolled]);
+
+  return (
+    <header
+      ref={headerRef}
+      className={`sticky top-0 z-[100] w-full bg-[#F8F9FA]/95 dark:bg-[#111216]/95 backdrop-blur-md pt-[var(--space-header-py)] pb-2 select-none border-b border-transparent will-change-[height] [overflow-anchor:none] ${
+        isJdOpen ? "max-lg:hidden" : ""
+      }`}
+      style={
+        {
+          "--search-h-full": "var(--control-h-lg)",
+          "--search-h-compact": "var(--control-h-md)",
+          "--search-mobile-h-full": "clamp(2.625rem, calc(2.463rem + 0.722vw), 2.75rem)",
+          "--search-radius-full": "var(--border-radius-card)",
+          "--search-radius-compact": "var(--border-radius-pill)",
+          "--search-compact-max-w": "clamp(20rem, calc(17rem + 6vw), 25rem)",
+          "--header-compact-side-clearance": "clamp(29rem, calc(25rem + 7vw), 34rem)",
+          "--gap-header-row": "clamp(1.375rem, calc(1.05rem + 0.8vw), 1.75rem)",
+          "--gap-header-row-mobile": "clamp(1.0rem, calc(0.85rem + 0.65vw), 1.25rem)",
+          "--gap-full": "clamp(0.625rem, calc(0.521rem + 0.463vw), 0.9375rem)",
+          "--gap-compact": "clamp(0.5rem, calc(0.438rem + 0.278vw), 0.6875rem)",
+          "--search-travel-y": "calc(var(--control-h-md) + var(--gap-header-row))",
+          "--tab-travel-y": "calc(-1 * var(--control-h-md) * 0.75)",
+          "--header-compact-h": "6.75rem",
+          "--search-icon-pad": "calc(0.875rem + 0.375rem * var(--scroll-inv-p, 1))",
+          "--shortcuts-gap": "calc(var(--gap-full) * var(--scroll-inv-p, 1) + var(--gap-compact) * var(--scroll-p, 0))",
+        } as React.CSSProperties
+      }
+    >
+      <div className="fluid-container relative">
+        {/* ROW 1: Logo & Morphing Wordmark | Tab Switcher | Right Actions */}
+        <HeaderNav isJobBoard={isJobBoard} scrollProgress={scrollProgress} />
+
+        {/* MOBILE ROW 2: SINGLE MORPHING SEARCHBAR BUTTON */}
+        {isJobBoard && (
+          <div className="block lg:hidden">
+            <MobileSearchButton scrollProgress={scrollProgress} />
+          </div>
+        )}
+
+        {/* MOBILE ROW 2 SPACER: Reserves layout space for mobile search button in Full mode, collapses cleanly to 0 in Compact mode */}
+        {isJobBoard && (
+          <div
+            className="block lg:hidden w-full will-change-[height]"
+            style={{
+              height: "calc((var(--search-mobile-h-full, 42px) + var(--gap-header-row-mobile, 1.0rem)) * var(--scroll-inv-p, 1))",
+            }}
+            aria-hidden="true"
+          />
+        )}
+
+        {/* DESKTOP ROW 2: PHYSICAL MORPHING SEARCHBAR */}
+        {isJobBoard && (
+          <div className="hidden lg:block">
+            <HeaderSearchbar
+              scrollProgress={scrollProgress}
+              isTransitioning={isTransitioning}
+              isFocusedOverride={isFocusedOverride}
+              setFocusedOverride={setFocusedOverride}
+              isDrawerExpanded={isDrawerExpanded}
+              drawerHeight={drawerHeight}
+              onDrawerExpandChange={setIsDrawerExpanded}
+              onDrawerHeightChange={setDrawerHeight}
+            />
+          </div>
+        )}
+
+        {/* DESKTOP ROW 2 SPACER: Provides layout space for Searchbar in Full mode, collapses cleanly to 0 in Compact mode */}
+        {isJobBoard && (
+          <div
+            className="hidden lg:block w-full will-change-[height]"
+            style={{
+              height: "calc((var(--search-h-full) + var(--gap-header-row)) * var(--scroll-inv-p, 1))",
+            }}
+            aria-hidden="true"
+          />
+        )}
+
+        {/* DESKTOP DRAWER EXPANSION SPACER: Smoothly moves filter shortcuts down to create space for expanded searchbar */}
+        {isJobBoard && (
+          <div
+            className="hidden lg:block w-full overflow-hidden transition-[height] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-[height]"
+            style={{
+              height: isDrawerExpanded && scrollProgress < 0.2 ? `${drawerHeight}px` : "0px",
+            }}
+            aria-hidden="true"
+          />
+        )}
+
+        {/* ROW 3: Filter Button, Reset Button & Quick Filter Shortcuts */}
+        {isJobBoard && (
+          <HeaderShortcuts
+            containerRef={shortcutsContainerRef}
+            trackRef={shortcutsTrackRef}
+          />
+        )}
+      </div>
+    </header>
+  );
+}
diff --git a/components/JobBoardView.tsx b/components/JobBoardView.tsx
new file mode 100644
--- /dev/null
+++ b/components/JobBoardView.tsx
@@ -0,0 +1,216 @@
+"use client";
+
+import { useEffect, useRef, useCallback } from "react";
+import { Job } from "@/types";
+import { useJobStore } from "@/store/useJobStore";
+import { JobGrid } from "./JobGrid";
+import { Pagination } from "./Pagination";
+import { JobDescriptionPanel } from "./JobDescriptionPanel";
+import { DEFAULT_PAGE_SIZE } from "@/lib/job-utils";
+import { lockBodyScroll, unlockBodyScroll } from "@/lib/utils/scrollLock";
+
+export interface JobBoardViewProps {
+  banner?: React.ReactNode;
+  jobs: Job[];
+  total: number;
+  totalPages: number;
+  page: number;
+  pageSize?: number;
+  onPageChange: (newPage: number, source?: "top" | "bottom") => void;
+  onResetFilters?: () => void;
+  isLoading?: boolean;
+  isFetching?: boolean;
+  isPremium?: boolean;
+  variant?: "emerald" | "purple" | "blue";
+}
+
+export function JobBoardView({
+  banner,
+  jobs,
+  total,
+  totalPages,
+  page,
+  pageSize = DEFAULT_PAGE_SIZE,
+  onPageChange,
+  onResetFilters,
+  isLoading = false,
+  isFetching = false,
+  isPremium = false,
+  variant = "emerald",
+}: JobBoardViewProps) {
+  const isJdOpen = useJobStore((s) => s.isJdOpen);
+  const activeJdJob = useJobStore((s) => s.activeJdJob);
+  const setActiveJdJob = useJobStore((s) => s.setActiveJdJob);
+  const closeJd = useJobStore((s) => s.closeJd);
+
+  const prevIsJdOpenRef = useRef(isJdOpen);
+  const prevJobIdRef = useRef<string | null>(null);
+  const rafIdRef = useRef<number | null>(null);
+
+  // Smooth alignment when JD panel is opened or when switching jobs in split view
+  useEffect(() => {
+    // Only execute desktop side-by-side card alignment on desktop viewports (lg: >= 1024px)
+    const isDesktop = typeof window !== "undefined" && window.innerWidth >= 1024;
+    if (!isDesktop || !isJdOpen || !activeJdJob) {
+      prevIsJdOpenRef.current = isJdOpen;
+      prevJobIdRef.current = activeJdJob ? activeJdJob.id : null;
+      return;
+    }
+
+    const isFirstOpen = !prevIsJdOpenRef.current && isJdOpen;
+    const isNewJob = prevJobIdRef.current !== activeJdJob.id;
+
+    if (isFirstOpen || isNewJob) {
+      if (rafIdRef.current) {
+        cancelAnimationFrame(rafIdRef.current);
+      }
+
+      // Use double requestAnimationFrame to ensure layout reflow (3-col -> 1-col) has completed
+      rafIdRef.current = requestAnimationFrame(() => {
+        rafIdRef.current = requestAnimationFrame(() => {
+          const activeCard = document.getElementById(`job-card-${activeJdJob.id}`);
+          if (activeCard) {
+            // Measure actual live sticky header height
+            const headerEl = document.querySelector("header");
+            const headerHeight = headerEl ? headerEl.getBoundingClientRect().height : 108;
+            const topGap = 16; // 1rem breathing room below sticky header matching JD sticky top
+            const targetStickyTop = headerHeight + topGap;
+
+            const cardRect = activeCard.getBoundingClientRect();
+            // Calculate absolute target window scroll position to align card top with sticky top
+            const targetY = window.scrollY + cardRect.top - targetStickyTop;
+
+            window.scrollTo({
+              top: Math.max(0, targetY),
+              behavior: "smooth",
+            });
+          }
+        });
+      });
+    }
+
+    prevIsJdOpenRef.current = isJdOpen;
+    prevJobIdRef.current = activeJdJob.id;
+
+    return () => {
+      if (rafIdRef.current) {
+        cancelAnimationFrame(rafIdRef.current);
+      }
+    };
+  }, [isJdOpen, activeJdJob]);
+
+  // Lock body scroll on mobile / tablet when modal drawer overlay is open
+  useEffect(() => {
+    const isMobileOrTablet = typeof window !== "undefined" && window.innerWidth < 1024;
+    if (isJdOpen && isMobileOrTablet) {
+      lockBodyScroll();
+      return () => {
+        unlockBodyScroll();
+      };
+    }
+  }, [isJdOpen]);
+
+  // Clean up global JD panel state on unmount
+  useEffect(() => {
+    return () => {
+      closeJd();
+    };
+  }, [closeJd]);
+
+  const handleSelectJob = useCallback((job: Job) => {
+    setActiveJdJob(job);
+  }, [setActiveJdJob]);
+
+  return (
+    <div className="w-full">
+      {banner}
+
+      {isJdOpen && activeJdJob ? (
+        /* Split-View Layout: Left List + Right JD Side Panel */
+        <div className="flex flex-col lg:flex-row gap-6 items-start pt-1">
+          {/* Left Column: Compact single-column card list */}
+          <div className="w-full lg:w-[380px] xl:w-[420px] 2xl:w-[460px] shrink-0 flex flex-col gap-3 pb-24 lg:pb-32">
+            {total > 0 && (
+              <Pagination
+                currentPage={page}
+                totalPages={totalPages}
+                totalResults={total}
+                pageSize={pageSize}
+                onPageChange={onPageChange}
+                position="top"
+                forceCompact={true}
+              />
+            )}
+
+            <JobGrid
+              jobs={jobs}
+              isSplitView={true}
+              activeJobId={activeJdJob.id}
+              onSelectJob={handleSelectJob}
+              onResetFilters={onResetFilters}
+              isLoading={isLoading || isFetching}
+              isPremium={isPremium}
+              variant={variant}
+            />
+
+            {total > 0 && (
+              <Pagination
+                currentPage={page}
+                totalPages={totalPages}
+                totalResults={total}
+                pageSize={pageSize}
+                onPageChange={onPageChange}
+                position="bottom"
+                forceCompact={true}
+              />
+            )}
+          </div>
+
+          {/* Dedicated JD Panel: Desktop Sticky Side Panel / Mobile Dedicated Full-Screen View */}
+          <div
+            className="max-lg:fixed max-lg:!inset-0 max-lg:!top-0 max-lg:z-[150] max-lg:w-full max-lg:h-[100dvh] max-lg:bg-bg-page dark:max-lg:bg-[#111216] max-lg:flex max-lg:flex-col lg:flex-1 min-w-0 lg:sticky overscroll-contain transition-[top] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] animate-in fade-in duration-200"
+            style={{
+              top: "calc(var(--header-compact-h, 6.75rem) + 1rem)",
+            }}
+          >
+            <JobDescriptionPanel job={activeJdJob} onClose={closeJd} />
+          </div>
+        </div>
+      ) : (
+        /* Default Full Width 3-Column Grid View */
+        <div>
+          {total > 0 && (
+            <Pagination
+              currentPage={page}
+              totalPages={totalPages}
+              totalResults={total}
+              pageSize={pageSize}
+              onPageChange={onPageChange}
+              position="top"
+            />
+          )}
+
+          <JobGrid
+            jobs={jobs}
+            onSelectJob={handleSelectJob}
+            onResetFilters={onResetFilters}
+            isLoading={isLoading || isFetching}
+            isPremium={isPremium}
+            variant={variant}
+          />
+
+          {total > 0 && (
+            <Pagination
+              currentPage={page}
+              totalPages={totalPages}
+              totalResults={total}
+              pageSize={pageSize}
+              onPageChange={onPageChange}
+              position="bottom"
+            />
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
