+"use client";
+
+import { useEffect, useRef, useState, useMemo, useCallback } from "react";
+import { X, RotateCcw } from "lucide-react";
+import { useJobStore, useAppFilters } from "@/store/useJobStore";
+import { useQuery, keepPreviousData } from "@tanstack/react-query";
+import { useDebounce } from "@/lib/hooks/useDebounce";
+import { useEscapeKey } from "@/lib/hooks/useEscapeKey";
+import { lockBodyScroll, unlockBodyScroll } from "@/lib/utils/scrollLock";
+
+import {
+  DOMAIN_OPTIONS,
+  JOB_TYPE_OPTIONS,
+  SENIORITY_OPTIONS,
+  POSTED_TIME_OPTIONS,
+  VISA_OPTIONS,
+  WORK_MODE_OPTIONS,
+} from "@/lib/constants/filters";
+
+interface FiltersModalProps {
+  totalMatches?: number;
+  variant?: "default" | "saved";
+}
+
+interface DraftFilters {
+  categories: string[];
+  jobType: string;
+  seniority: string;
+  minSalary: number;
+  postedTime: string;
+  visaSponsorship: string;
+  workMode: string;
+}
+
+export function FiltersModal({ totalMatches = 0, variant = "default" }: FiltersModalProps) {
+  const isFilterMenuOpen = useJobStore((s) => s.isFilterMenuOpen);
+  const setIsFilterMenuOpen = useJobStore((s) => s.setIsFilterMenuOpen);
+  const {
+    searchQuery,
+    locationQuery,
+    searchBy,
+    location,
+    categories,
+    jobType,
+    seniority,
+    minSalary,
+    postedTime,
+    visaSponsorship,
+    workMode,
+  } = useAppFilters(variant);
+
+  const modalRef = useRef<HTMLDivElement>(null);
+  const [showAllDomains, setShowAllDomains] = useState(false);
+
+  // Consolidated draft filter state
+  const [draft, setDraft] = useState<DraftFilters>(() => ({
+    categories,
+    jobType,
+    seniority,
+    minSalary,
+    postedTime,
+    visaSponsorship,
+    workMode,
+  }));
+
+  // Smooth Enter / Exit Animation State Management
+  const [isRendered, setIsRendered] = useState(isFilterMenuOpen);
+  const [isVisible, setIsVisible] = useState(isFilterMenuOpen);
+
+  // Synchronize draft state and visibility when modal opens/closes during render before paint
+  const [prevIsOpen, setPrevIsOpen] = useState(isFilterMenuOpen);
+  if (prevIsOpen !== isFilterMenuOpen) {
+    setPrevIsOpen(isFilterMenuOpen);
+    if (isFilterMenuOpen) {
+      setIsRendered(true);
+      setIsVisible(false);
+      setDraft({
+        categories,
+        jobType,
+        seniority,
+        minSalary,
+        postedTime,
+        visaSponsorship,
+        workMode,
+      });
+    } else {
+      setIsVisible(false);
+    }
+  }
+
+  useEffect(() => {
+    if (isFilterMenuOpen) {
+      const frame = requestAnimationFrame(() => {
+        setIsVisible(true);
+      });
+      return () => cancelAnimationFrame(frame);
+    } else {
+      const timer = setTimeout(() => {
+        setIsRendered(false);
+      }, 220);
+      return () => clearTimeout(timer);
+    }
+  }, [isFilterMenuOpen]);
+
+  // Close on Escape key
+  useEscapeKey(() => setIsFilterMenuOpen(false), isFilterMenuOpen);
+
+  // Lock body scroll when modal is open
+  useEffect(() => {
+    if (isFilterMenuOpen) {
+      lockBodyScroll();
+      return () => {
+        unlockBodyScroll();
+      };
+    }
+  }, [isFilterMenuOpen]);
+
