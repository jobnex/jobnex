+    const api=load('lib/resume-imports.ts',{'@/lib/db':{pool:{connect:async()=>({query:(sql,args)=>db.query(sql,args),release(){}})}},
+      '@/lib/storage/r2':{},'@/app/actions/storage':{},'@/lib/profile-service':{}});
+    const seed=async()=>{
