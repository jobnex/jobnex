+  // Window-level Ctrl + wheel listener so pinch gestures outside the container also scale the container
+  useEffect(() => {
+    if (!isOpen) return;
+
+    const handleWindowWheel = (e: WheelEvent) => {
+      if (e.ctrlKey || e.metaKey) {
