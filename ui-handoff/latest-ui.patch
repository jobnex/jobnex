+    return () => {
+      isCancelled = true;
+    };
+  }, [isOpen, activeItem?.filePath, ensurePdfJsLoaded]);
+
+  // Track the actual DOM width of the preview container via ResizeObserver
+  useEffect(() => {
+    const el = containerRef.current;
+    if (!el || !isOpen) return;
