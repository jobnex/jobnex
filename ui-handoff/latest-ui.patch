+  return (
+    <PricingDarkThemeWrapper>
+      <Suspense fallback={<div className="min-h-screen bg-[#0b0d12]" />}>
+        <PricingView initialPlan={initialPlan} />
+      </Suspense>
+    </PricingDarkThemeWrapper>
+  );
+}
