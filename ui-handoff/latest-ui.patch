+              onSelect={onSelectJob}
+            />
+          ) : (
+            <JobCard 
+              key={job.id} 
+              job={job} 
+              compact={true} 
+              isActive={job.id === activeJobId} 
+              onSelect={onSelectJob}
+            />
+          )
+        ))}
+      </div>
+    );
+  }
+
+  // Default Grid Layout
+  return (
+    <div className={`grid grid-cols-1 sm:grid-cols-2 ${twoColumns ? 'lg:grid-cols-2' : 'lg:grid-cols-3'} fluid-grid-gap fluid-card-container`}>
+      {jobs.map((job) => (
+        isPremium ? (
+          <PremiumJobCard
+            key={job.id}
+            job={job}
+            variant={variant}
+            isRequested={isRequested || Boolean((job as { isRequested?: boolean }).isRequested)}
+            isActive={job.id === activeJobId}
+            onSelect={onSelectJob}
+          />
+        ) : (
+          <JobCard 
+            key={job.id} 
+            job={job} 
+            isActive={job.id === activeJobId} 
+            onSelect={onSelectJob} 
+          />
+        )
+      ))}
+    </div>
+  );
+});
